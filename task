#include <CL/cl.hpp>
#include <iostream>
#include <vector>
#include <chrono>
#include <omp.h>

#define VECTOR_SIZE 1000000

// Function to generate random float values for the vector
void generateRandomVector(std::vector<float>& vec) {
    for (size_t i = 0; i < vec.size(); ++i) {
        vec[i] = static_cast<float>(rand()) / RAND_MAX;
    }
}

int main() {
    // Step 1: Generate random vectors A and B of size VECTOR_SIZE
    std::vector<float> A(VECTOR_SIZE), B(VECTOR_SIZE), C(VECTOR_SIZE);
    generateRandomVector(A);
    generateRandomVector(B);

    try {
        // Step 2: OpenCL Setup
        // Get available platforms and select the default one
        std::vector<cl::Platform> platforms;
        cl::Platform::get(&platforms);
        cl::Platform defaultPlatform = platforms[0];

        // Get devices and select the default one
        std::vector<cl::Device> devices;
        defaultPlatform.getDevices(CL_DEVICE_TYPE_ALL, &devices);
        cl::Device defaultDevice = devices[0];

        // Create context and command queue
        cl::Context context(defaultDevice);
        cl::CommandQueue queue(context, defaultDevice);

        // Step 3: Create memory buffers on the device
        cl::Buffer bufferA(context, CL_MEM_READ_ONLY, sizeof(float) * VECTOR_SIZE);
        cl::Buffer bufferB(context, CL_MEM_READ_ONLY, sizeof(float) * VECTOR_SIZE);
        cl::Buffer bufferC(context, CL_MEM_WRITE_ONLY, sizeof(float) * VECTOR_SIZE);

        // Write vectors A and B to the device
        queue.enqueueWriteBuffer(bufferA, CL_TRUE, 0, sizeof(float) * VECTOR_SIZE, A.data());
        queue.enqueueWriteBuffer(bufferB, CL_TRUE, 0, sizeof(float) * VECTOR_SIZE, B.data());

        // Kernel code for vector addition
        const char* kernelCode = R"(
        __kernel void vector_add(__global const float* A, __global const float* B, __global float* C) {
            int id = get_global_id(0);
            C[id] = A[id] + B[id];
        })";

        // Step 4: Build and compile the kernel
        cl::Program::Sources sources;
        sources.push_back({kernelCode, strlen(kernelCode)});
        cl::Program program(context, sources);
        program.build({defaultDevice});

        // Create kernel object and set arguments
        cl::Kernel kernel(program, "vector_add");
        kernel.setArg(0, bufferA);
        kernel.setArg(1, bufferB);
        kernel.setArg(2, bufferC);

        // Step 5: Execute the kernel
        auto startOpenCL = std::chrono::high_resolution_clock::now();
        queue.enqueueNDRangeKernel(kernel, cl::NullRange, cl::NDRange(VECTOR_SIZE), cl::NullRange);
        queue.finish();
        auto endOpenCL = std::chrono::high_resolution_clock::now();

        // Read the results back from the device
        queue.enqueueReadBuffer(bufferC, CL_TRUE, 0, sizeof(float) * VECTOR_SIZE, C.data());

        auto openCLDuration = std::chrono::duration_cast<std::chrono::milliseconds>(endOpenCL - startOpenCL).count();

        // Step 6: Multi-threaded CPU implementation
        std::vector<float> C_mt(VECTOR_SIZE);
        auto startMT = std::chrono::high_resolution_clock::now();
        #pragma omp parallel for
        for (size_t i = 0; i < VECTOR_SIZE; ++i) {
            C_mt[i] = A[i] + B[i];
        }
        auto endMT = std::chrono::high_resolution_clock::now();

        auto mtDuration = std::chrono::duration_cast<std::chrono::milliseconds>(endMT - startMT).count();

        // Step 7: Output results
        std::cout << "Results are\n";
        std::cout << "OpenCL (CPU) time: " << openCLDuration << " ms\n";
        std::cout << "Multi-threaded CPU time: " << mtDuration << " ms\n";
    } catch (cl::Error& e) {
        std::cerr << "OpenCL Error: " << e.what() << " (" << e.err() << ")" << std::endl;
        return -1;
    }

    return 0;
}
